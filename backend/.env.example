# Database Configuration
DB_URL=jdbc:postgresql://your-pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=your-database-password

# Database API Configuration (if using Supabase API)
DB_API_URL=https://your-project-ref.supabase.co
DB_ANON_KEY=your-anon-key

# RabbitMQ Configuration
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# CustomAuth JWT Secret (generate a strong secret for production)
JWT_SECRET=your-secure-jwt-secret-key-change-this

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
